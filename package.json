{
  "name": "mainframe-commander",
  "displayName": "Mainframe Commander",
  "description": "Total Commander-style dual-pane file manager for z/OS, powered by Zowe.",
  "version": "0.1.0",
  "publisher": "ubidk",
  "license": "EPL-2.0",
  "author": {
    "name": "ubi.dk",
    "url": "https://ubi.dk"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#151b27",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/san/mainframe-commander.git"
  },
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "mainframe",
    "zowe",
    "z/OS",
    "mvs",
    "uss",
    "jes",
    "commander"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mc.open",
        "title": "Mainframe Commander: Open",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "mc.key",
        "title": "Mainframe Commander: Forward key to panel"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mc.key",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mc.open",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "mc.key",
        "args": {
          "key": "F1"
        },
        "key": "f1",
        "when": "activeWebviewPanelId == mainframeCommander"
      },
      {
        "command": "mc.key",
        "args": {
          "key": "F3"
        },
        "key": "f3",
        "when": "activeWebviewPanelId == mainframeCommander"
      },
      {
        "command": "mc.key",
        "args": {
          "key": "Shift+F3"
        },
        "key": "shift+f3",
        "when": "activeWebviewPanelId == mainframeCommander"
      },
      {
        "command": "mc.key",
        "args": {
          "key": "F4"
        },
        "key": "f4",
        "when": "activeWebviewPanelId == mainframeCommander"
      },
      {
        "command": "mc.key",
        "args": {
          "key": "F5"
        },
        "key": "f5",
        "when": "activeWebviewPanelId == mainframeCommander"
      },
      {
        "command": "mc.key",
        "args": {
          "key": "Shift+F5"
        },
        "key": "shift+f5",
        "when": "activeWebviewPanelId == mainframeCommander"
      },
      {
        "command": "mc.key",
        "args": {
          "key": "F6"
        },
        "key": "f6",
        "when": "activeWebviewPanelId == mainframeCommander"
      },
      {
        "command": "mc.key",
        "args": {
          "key": "F7"
        },
        "key": "f7",
        "when": "activeWebviewPanelId == mainframeCommander"
      },
      {
        "command": "mc.key",
        "args": {
          "key": "F8"
        },
        "key": "f8",
        "when": "activeWebviewPanelId == mainframeCommander"
      },
      {
        "command": "mc.key",
        "args": {
          "key": "F9"
        },
        "key": "f9",
        "when": "activeWebviewPanelId == mainframeCommander"
      },
      {
        "command": "mc.key",
        "args": {
          "key": "F10"
        },
        "key": "f10",
        "when": "activeWebviewPanelId == mainframeCommander"
      },
      {
        "command": "mc.key",
        "args": {
          "key": "Ctrl+j"
        },
        "key": "ctrl+j",
        "when": "activeWebviewPanelId == mainframeCommander"
      },
      {
        "command": "mc.key",
        "args": {
          "key": "Ctrl+f"
        },
        "key": "ctrl+f",
        "when": "activeWebviewPanelId == mainframeCommander"
      },
      {
        "command": "mc.key",
        "args": {
          "key": "Ctrl+d"
        },
        "key": "ctrl+d",
        "when": "activeWebviewPanelId == mainframeCommander"
      },
      {
        "command": "mc.key",
        "args": {
          "key": "Alt+1"
        },
        "key": "alt+1",
        "when": "activeWebviewPanelId == mainframeCommander"
      },
      {
        "command": "mc.key",
        "args": {
          "key": "Alt+2"
        },
        "key": "alt+2",
        "when": "activeWebviewPanelId == mainframeCommander"
      },
      {
        "command": "mc.key",
        "args": {
          "key": "Alt+3"
        },
        "key": "alt+3",
        "when": "activeWebviewPanelId == mainframeCommander"
      },
      {
        "command": "mc.key",
        "args": {
          "key": "Alt+4"
        },
        "key": "alt+4",
        "when": "activeWebviewPanelId == mainframeCommander"
      }
    ],
    "configuration": {
      "title": "Mainframe Commander",
      "properties": {
        "mc.panes.left": {
          "type": "object",
          "default": {
            "kind": "local",
            "profile": "",
            "path": ""
          },
          "markdownDescription": "Where the left pane starts. `kind` is one of `local`, `ds`, `uss`, `jes`. After that the pane reopens wherever you last left it — change this setting to override that and start somewhere else.",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "local",
                "ds",
                "uss",
                "jes"
              ]
            },
            "profile": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          }
        },
        "mc.panes.right": {
          "type": "object",
          "default": {
            "kind": "ds",
            "profile": "",
            "path": ""
          },
          "markdownDescription": "Where the right pane starts. An empty `profile` means the default Zowe profile. After that the pane reopens wherever you last left it — change this setting to override that and start somewhere else."
        },
        "mc.transfer.defaultMode": {
          "type": "string",
          "enum": [
            "text",
            "binary",
            "auto"
          ],
          "default": "auto",
          "markdownDescription": "Default transfer mode for F5. `auto` picks binary for the extensions in `#mc.transfer.binaryExtensions#` and text for everything else."
        },
        "mc.transfer.binaryExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".gz",
            ".zip",
            ".tar",
            ".jar",
            ".war",
            ".png",
            ".jpg",
            ".gif",
            ".pdf",
            ".class",
            ".so",
            ".bin"
          ],
          "description": "Extensions treated as binary when the transfer mode is 'auto'."
        },
        "mc.transfer.codepage": {
          "type": "string",
          "default": "IBM-277",
          "markdownDescription": "Codepage used for text transfers when the target does not declare one. Picked in the F5 dialog, which writes your choice back here. `IBM-277` is Denmark/Norway; `IBM-1142` is the same page with the euro sign, `IBM-037` is US."
        },
        "mc.transfer.codepages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "IBM-037",
            "IBM-273",
            "IBM-277",
            "IBM-278",
            "IBM-280",
            "IBM-284",
            "IBM-285",
            "IBM-297",
            "IBM-500",
            "IBM-870",
            "IBM-871",
            "IBM-1025",
            "IBM-1026",
            "IBM-1047",
            "IBM-1140",
            "IBM-1141",
            "IBM-1142",
            "IBM-1143",
            "IBM-1144",
            "IBM-1145",
            "IBM-1146",
            "IBM-1147",
            "IBM-1148",
            "IBM-1149",
            "ISO8859-1",
            "UTF-8"
          ],
          "markdownDescription": "Codepages offered by the picker in the F5 dialog. Add your own if your site uses a page that is not listed; `#mc.transfer.codepage#` is always offered whether it is in this list or not."
        },
        "mc.transfer.longLines": {
          "type": "string",
          "enum": [
            "wrap",
            "truncate",
            "abort"
          ],
          "default": "abort",
          "markdownDescription": "What to do when a text line is longer than the target LRECL. `abort` is the safe default — silent truncation corrupts JCL."
        },
        "mc.transfer.skipDialog": {
          "type": "boolean",
          "default": false,
          "description": "Start transfers straight away using the defaults above. Shift+F5 always skips the dialog."
        },
        "mc.transfer.concurrency": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "How many transfers run at the same time."
        },
        "mc.view.ebcdicCodepage": {
          "type": "string",
          "default": "",
          "markdownDescription": "EBCDIC page `Shift+F3` decodes with. Empty means `#mc.transfer.codepage#`. Only single-byte EBCDIC pages can be decoded here — set this when your transfer codepage is `UTF-8` or `ISO8859-1`."
        },
        "mc.view.ebcdicRecordLength": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "markdownDescription": "Record length `Shift+F3` splits on when the bytes carry no x'15' newline of their own — a data set read as records rather than as a stream. The data set's own LRECL is used when it is known; this only decides the case where it is not, such as a local file."
        },
        "mc.confirmDelete": {
          "type": "boolean",
          "default": true,
          "description": "Ask before deleting (F8)."
        },
        "mc.list.pageSize": {
          "type": "number",
          "default": 1000,
          "description": "Maximum entries fetched per listing before the pane reports a truncated view."
        },
        "mc.jes.autoRefreshSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "How often a JES pane refreshes itself. 0 disables auto-refresh."
        },
        "mc.ds.defaultFilter": {
          "type": "string",
          "default": "",
          "markdownDescription": "Dataset filter a DS pane opens on when its path is empty. Empty means `<YOUR-USER>.*`. Avoid a bare `*` — it asks z/OSMF to walk the entire catalog and usually fails in TSO's list services (LMDINIT)."
        },
        "mc.jes.owner": {
          "type": "string",
          "default": "",
          "markdownDescription": "Owner a JES pane filters on when its path does not say. Empty means the session user. This is only the starting point — `Ctrl+F` changes owner and job name for the pane you are in, and `Ctrl+D` saves the result as a named view."
        },
        "mc.favourites": {
          "type": "array",
          "default": [],
          "markdownDescription": "Saved views: places a pane can jump back to, added with `Ctrl+D`. Each one also appears as a ★ tab in the pane header when a pane is in the same world and on the same profile.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "location"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "What the tab says. Saving over a name replaces it."
              },
              "location": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "local",
                      "ds",
                      "uss",
                      "jes"
                    ]
                  },
                  "profile": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string",
                    "markdownDescription": "As in `mc.panes.*`: a directory, a dataset filter, or a JES filter such as `owner=IBMUSER;prefix=BK*;status=output`."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p webview/tsconfig.json",
    "vsix": "node scripts/package-vsix.mjs",
    "vscode:prepublish": "npm run typecheck && npm run package"
  },
  "dependencies": {
    "@zowe/secrets-for-zowe-sdk": "^8.37.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/vscode": "^1.138.0",
    "@vscode/vsce": "^4.0.0",
    "@zowe/core-for-zowe-sdk": "^8.37.0",
    "@zowe/imperative": "^8.37.0",
    "@zowe/zos-files-for-zowe-sdk": "^8.37.0",
    "@zowe/zos-jobs-for-zowe-sdk": "^8.37.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
